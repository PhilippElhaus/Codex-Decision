{
  "name": "codex-jev-control",
  "displayName": "Codex Jev Control",
  "description": "Jev integration controls inside the Codex composer",
  "version": "0.2.19",
  "publisher": "elhaus-labs",
  "license": "MIT",
  "icon": "icon.png",
  "repository": { "type": "git", "url": "https://github.com/PhilippElhaus/Codex-Jev.git" },
  "private": true,
  "main": "./extension.js",
  "engines": { "vscode": "^1.96.2" },
  "extensionKind": ["ui"],
  "activationEvents": ["onStartupFinished", "onCommand:codexJev.bridge"],
  "contributes": {
    "commands": [
      { "command": "codexJev.checkConnection", "title": "Jev: Check API and Key" }
    ],
    "configuration": {
      "title": "Codex Jev Control",
      "properties": {
        "codexJev.dataDirectory": {
          "type": "string",
          "default": "",
          "description": "Absolute PLUGIN_DATA directory for Codex Jev. Set this to the installed plugin data directory, or set CODEX_JEV_DATA_DIRECTORY."
        },
        "codexJev.mode": {
          "type": "string",
          "enum": ["replace", "observe"],
          "default": "replace",
          "scope": "application",
          "description": "Filter shortens approved output. Monitor records decisions and keeps full output. Stored values remain replace and observe."
        }
      }
    }
  },
  "scripts": { "test": "node --test ../tests/unit/*.test.cjs ../tests/integration/*.test.cjs ../tests/edge/*.test.cjs ../tests/load/*.test.cjs" }
}
