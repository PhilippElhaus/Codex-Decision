{
  "name": "codex-decision-control",
  "displayName": "Codex Decision Control",
  "description": "Decision on/off control and live decision panel for VS Code",
  "version": "0.10.11",
  "codexDecisionHookVersion": "0.11.5",
  "publisher": "elhaus-labs",
  "license": "MIT",
  "icon": "icon.png",
  "repository": { "type": "git", "url": "https://github.com/PhilippElhaus/Codex-Decision.git" },
  "private": true,
  "main": "./extension.js",
  "engines": { "vscode": "^1.96.2" },
  "extensionKind": ["ui"],
  "activationEvents": ["onStartupFinished", "onCommand:codexDecision.bridge", "onView:codexDecisionDecision"],
  "contributes": {
    "commands": [
      { "command": "codexDecision.checkConnection", "title": "Decision: Check API and Key" },
      { "command": "codexDecision.showLatestDecision", "title": "Decision: Show Latest Decision" }
    ],
    "viewsContainers": {
      "panel": [
        { "id": "codexDecisionDecisionPanel", "title": "Decision", "icon": "media/decision-panel.svg" }
      ]
    },
    "views": {
      "codexDecisionDecisionPanel": [
        { "id": "codexDecisionDecision", "name": "Latest decision", "type": "webview", "visibility": "visible" }
      ]
    },
    "configuration": {
      "title": "Codex Decision Control",
      "properties": {
        "codexDecision.dataDirectory": {
          "type": "string",
          "default": "",
          "description": "Absolute PLUGIN_DATA directory for Codex Decision. Set this to the installed plugin data directory, or set CODEX_DECISION_DATA_DIRECTORY."
        }
      }
    }
  },
  "scripts": { "test": "node --test ../tests/unit/*.test.cjs ../tests/integration/*.test.cjs ../tests/edge/*.test.cjs ../tests/load/*.test.cjs" }
}
