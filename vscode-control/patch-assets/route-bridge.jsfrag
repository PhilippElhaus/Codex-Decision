function vK(){WG(_K(),`useLocation() may be used only in the context of a <Router> component.`);let decisionLocation=TK.useContext(ZK).location,decisionPath=decisionLocation.pathname,decisionLocal=/^\/(?:local|hotkey-window\/thread)\/([A-Za-z0-9._-]{1,128})\/?$/.exec(decisionPath),decisionRoute=document.documentElement.dataset;let decisionPrevious=decisionRoute.codexDecisionRouteKind+":"+decisionRoute.codexDecisionSessionId;let decisionKind=decisionLocal?"local":/^\/(?:remote|hotkey-window\/remote)\//.test(decisionPath)?"remote":"none";if(decisionRoute.codexDecisionRouteKind!==decisionKind)decisionRoute.codexDecisionRouteKind=decisionKind;if(decisionLocal){if(decisionRoute.codexDecisionSessionId!==decisionLocal[1])decisionRoute.codexDecisionSessionId=decisionLocal[1];}else if(decisionRoute.codexDecisionSessionId)delete decisionRoute.codexDecisionSessionId;if(decisionPrevious!==decisionRoute.codexDecisionRouteKind+":"+decisionRoute.codexDecisionSessionId)queueMicrotask(()=>window.dispatchEvent(new Event("codex-decision-route")));return decisionLocation}
