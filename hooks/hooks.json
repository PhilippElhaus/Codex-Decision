{
  "description": "One line-level Codex Decision PostToolUse filter. Controlled by the session enabled flag.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/bin/linux-x86_64/decision-hook\"",
            "timeout": 60,
            "statusMessage": "Evaluating large tool output"
          }
        ]
      }
    ]
  }
}
