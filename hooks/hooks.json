{
  "description": "Codex Jev output filter. Disabled until its hook is selected.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^Bash$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/post_tool_use.py\"",
            "timeout": 5,
            "statusMessage": "Evaluating large tool output"
          }
        ]
      }
    ]
  }
}
