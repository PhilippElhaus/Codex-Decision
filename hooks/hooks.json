{
  "description": "Three selectable line-level Codex Jev PostToolUse filters. Disabled until selected.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/bin/linux-x86_64/jev-hook\"",
            "timeout": 60,
            "statusMessage": "Evaluating large tool output"
          }
        ]
      }
    ]
  }
}
