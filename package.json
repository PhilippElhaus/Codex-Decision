{
  "name": "codex-decision-workspace",
  "private": true,
  "scripts": {
    "test": "nx run-many -t test-node test-python test-rust",
    "test:affected": "nx affected -t test-node test-python test-rust test-browser test-quality test-package",
    "test:full": "nx run-many -t test-node-full test-python-full test-rust-full",
